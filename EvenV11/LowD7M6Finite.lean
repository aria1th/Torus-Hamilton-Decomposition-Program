def rootFlatCertificate :
    Shared.RootFlatCertificate Color Direction RootState 6 where
  schedule := schedule
  rowLatin := schedule_rowLatin
  layerBijective := schedule_layerBijective
  returnsSingleCycle := schedule_returnsSingleCycle

theorem rootFlatReturnCriterion :
    Shared.RootFlatReturnCriterion Color Direction RootState 6 := by
  exact Shared.rootFlatReturnCriterion_of_certificate rootFlatCertificate

theorem rootFlatLayeredHamiltonian :
    Shared.RootFlatLayeredHamiltonDecomposition Color Direction RootState 6 := by
  exact Shared.rootFlatLayeredDecomposition_of_certificate rootFlatCertificate

def rootVecOfIndex (w : RootState) : StandardRootFlatLift.RootState 6 6 :=
  fun i => ((w.val / 6 ^ i.val) % 6 : Nat)

def indexOfRootVec (w : StandardRootFlatLift.RootState 6 6) : RootState :=
  natToFin 46656 (by decide)
    ((w 0).val + 6 * (w 1).val + 36 * (w 2).val +
      216 * (w 3).val + 1296 * (w 4).val + 7776 * (w 5).val)

def rootIndexEquiv : RootState ≃ StandardRootFlatLift.RootState 6 6 where
  toFun := rootVecOfIndex
  invFun := indexOfRootVec
  left_inv := by
    intro w
    native_decide +revert
  right_inv := by
    intro w
    funext i
    native_decide +revert

def torusEquiv : ZMod 6 × RootState ≃ Shared.TorusVertex 7 6 :=
  (Equiv.prodCongr (Equiv.refl (ZMod 6)) rootIndexEquiv).trans
    (StandardRootFlatLift.torusEquiv 6 6)

theorem step_rootStep (i : Direction) (w : RootState) :
    rootIndexEquiv (step i w) =
      StandardRootFlatLift.rootStep i (rootIndexEquiv w) := by
  native_decide +revert

theorem torusEquiv_step (i : Direction) (tw : ZMod 6 × RootState) :
    torusEquiv tw + Shared.torusBasis 7 6 i =
      torusEquiv (tw.1 + 1, step i tw.2) := by
  change
    StandardRootFlatLift.torusEquiv 6 6 (tw.1, rootIndexEquiv tw.2) +
        Shared.torusBasis 7 6 i =
      StandardRootFlatLift.torusEquiv 6 6
        (tw.1 + 1, rootIndexEquiv (step i tw.2))
  rw [step_rootStep]
  exact StandardRootFlatLift.torusEquiv_step i
    (tw.1, rootIndexEquiv tw.2)

theorem finalStepConjugacy :
    ∀ c : Color, ∀ tw : ZMod 6 × RootState,
      Shared.cayleyColorStep
        (finalRootFlatModelColorDir schedule torusEquiv)
        c (torusEquiv tw) =
      torusEquiv (schedule.fullStep c tw) := by
  intro c tw
  simpa [Shared.cayleyColorStep, finalRootFlatModelColorDir,
    Shared.RootFlatSchedule.fullStep, Shared.RootFlatSchedule.layerMap]
    using torusEquiv_step (dir tw.1 tw.2 c) tw

def finalRootFlatModel :
    FinalRootFlatTorusModel 7 6 RootState schedule torusEquiv where
  rowLatin := schedule_rowLatin
  layerBijective := schedule_layerBijective
  returnsSingleCycle := schedule_returnsSingleCycle
  stepConjugacy := finalStepConjugacy

theorem finalRootFlatTorusCertificate :
    FinalRootFlatTorusCertificate 7 6 :=
  finalRootFlatTorusCertificate_of_model finalRootFlatModel

theorem finalLowD7M6RootFlatCertificateFamily :
    FinalLowD7M6RootFlatCertificateFamily :=
  finalLowD7M6RootFlatCertificateFamily_of_certificate
    finalRootFlatTorusCertificate

