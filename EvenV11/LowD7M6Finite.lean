import EvenV11.StandardRootFlatLift
import Shared.RootFlat

set_option linter.style.setOption false
set_option linter.style.longLine false
set_option maxHeartbeats 0
set_option maxRecDepth 1000000
set_option linter.style.nativeDecide false

namespace EvenV11
namespace LowD7M6Finite

open FiniteArrayCert
open FiniteArrayCert.Blob

abbrev Color := Fin 7
abbrev Direction := Fin 7
abbrev RootState := Fin 46656

def zmodToFin (m : Nat) [NeZero m] (t : ZMod m) : Fin m :=
  ⟨t.val, ZMod.val_lt t⟩

theorem zmodToFin_val_cast (m : Nat) [NeZero m] (t : ZMod m) :
    ((zmodToFin m t).val : ZMod m) = t := by
  exact ZMod.natCast_zmod_val t

def natToFin (N : Nat) (hN : 0 < N) (n : Nat) : Fin N :=
  ⟨n % N, Nat.mod_lt n hN⟩

def dirIndex (t : Fin 6) (w : RootState) (c : Color) : Nat :=
  (t.val * 46656 + w.val) * 7 + c.val

def dirBlob : String :=
  ""

def dir (t : ZMod 6) (w : RootState) (c : Color) : Direction :=
  natToFin 7 (by decide)
    (charAtVal dirBlob (dirIndex (zmodToFin 6 t) w c))

def powAt : Nat -> Nat
  | 0 => 1
  | 1 => 6
  | 2 => 36
  | 3 => 216
  | 4 => 1296
  | 5 => 7776
  | _ => 0

def stepNat (i x : Nat) : Nat :=
  if i = 6 then x else
    let p := powAt i
    let digit := (x / p) % 6
    if digit < 5 then x + p else x - 5 * p

def step (i : Direction) (w : RootState) : RootState :=
  natToFin 46656 (by decide) (stepNat i.val w.val)

