abbrev Color := Fin 7
abbrev Direction := Fin 7
abbrev RootState := Fin 4096

def zmodToFin (m : Nat) [NeZero m] (t : ZMod m) : Fin m :=
  ⟨t.val, ZMod.val_lt t⟩

theorem zmodToFin_val_cast (m : Nat) [NeZero m] (t : ZMod m) :
    ((zmodToFin m t).val : ZMod m) = t := by
  exact ZMod.natCast_zmod_val t

def natToFin (N : Nat) (hN : 0 < N) (n : Nat) : Fin N :=
  ⟨n % N, Nat.mod_lt n hN⟩

def dirIndex (t : Fin 4) (w : RootState) (c : Color) : Nat :=
  (t.val * 4096 + w.val) * 7 + c.val

def dirBlob : String :=
  ""

def dir (t : ZMod 4) (w : RootState) (c : Color) : Direction :=
  natToFin 7 (by decide)
    (charAtVal dirBlob (dirIndex (zmodToFin 4 t) w c))

def powAt : Nat -> Nat
  | 0 => 1
  | 1 => 4
  | 2 => 16
  | 3 => 64
  | 4 => 256
  | 5 => 1024
  | _ => 0

def stepNat (i x : Nat) : Nat :=
  if i = 6 then x else
    let p := powAt i
    let digit := (x / p) % 4
    if digit < 3 then x + p else x - 3 * p

def step (i : Direction) (w : RootState) : RootState :=
  natToFin 4096 (by decide) (stepNat i.val w.val)

