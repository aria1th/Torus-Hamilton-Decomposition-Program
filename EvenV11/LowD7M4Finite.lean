def rootFlatCertificate :
    Shared.RootFlatCertificate Color Direction RootState 4 where
  schedule := schedule
  rowLatin := schedule_rowLatin
  layerBijective := schedule_layerBijective
  returnsSingleCycle := schedule_returnsSingleCycle

theorem rootFlatReturnCriterion :
    Shared.RootFlatReturnCriterion Color Direction RootState 4 := by
  exact Shared.rootFlatReturnCriterion_of_certificate rootFlatCertificate

theorem rootFlatLayeredHamiltonian :
    Shared.RootFlatLayeredHamiltonDecomposition Color Direction RootState 4 := by
  exact Shared.rootFlatLayeredDecomposition_of_certificate rootFlatCertificate

def rootVecOfIndex (w : RootState) : StandardRootFlatLift.RootState 6 4 :=
  fun i => ((w.val / 4 ^ i.val) % 4 : Nat)

def indexOfRootVec (w : StandardRootFlatLift.RootState 6 4) : RootState :=
  natToFin 4096 (by decide)
    ((w 0).val + 4 * (w 1).val + 16 * (w 2).val +
      64 * (w 3).val + 256 * (w 4).val + 1024 * (w 5).val)

def rootIndexEquiv : RootState ≃ StandardRootFlatLift.RootState 6 4 where
  toFun := rootVecOfIndex
  invFun := indexOfRootVec
  left_inv := by
    intro w
    native_decide +revert
  right_inv := by
    intro w
    funext i
    native_decide +revert

def torusEquiv : ZMod 4 × RootState ≃ Shared.TorusVertex 7 4 :=
  (Equiv.prodCongr (Equiv.refl (ZMod 4)) rootIndexEquiv).trans
    (StandardRootFlatLift.torusEquiv 6 4)

theorem step_rootStep (i : Direction) (w : RootState) :
    rootIndexEquiv (step i w) =
      StandardRootFlatLift.rootStep i (rootIndexEquiv w) := by
  native_decide +revert

theorem torusEquiv_step (i : Direction) (tw : ZMod 4 × RootState) :
    torusEquiv tw + Shared.torusBasis 7 4 i =
      torusEquiv (tw.1 + 1, step i tw.2) := by
  change
    StandardRootFlatLift.torusEquiv 6 4 (tw.1, rootIndexEquiv tw.2) +
        Shared.torusBasis 7 4 i =
      StandardRootFlatLift.torusEquiv 6 4
        (tw.1 + 1, rootIndexEquiv (step i tw.2))
  rw [step_rootStep]
  exact StandardRootFlatLift.torusEquiv_step i
    (tw.1, rootIndexEquiv tw.2)

theorem finalStepConjugacy :
    ∀ c : Color, ∀ tw : ZMod 4 × RootState,
      Shared.cayleyColorStep
        (finalRootFlatModelColorDir schedule torusEquiv)
        c (torusEquiv tw) =
      torusEquiv (schedule.fullStep c tw) := by
  intro c tw
  simpa [Shared.cayleyColorStep, finalRootFlatModelColorDir,
    Shared.RootFlatSchedule.fullStep, Shared.RootFlatSchedule.layerMap]
    using torusEquiv_step (dir tw.1 tw.2 c) tw

def finalRootFlatModel :
    FinalRootFlatTorusModel 7 4 RootState schedule torusEquiv where
  rowLatin := schedule_rowLatin
  layerBijective := schedule_layerBijective
  returnsSingleCycle := schedule_returnsSingleCycle
  stepConjugacy := finalStepConjugacy

theorem finalRootFlatTorusCertificate :
    FinalRootFlatTorusCertificate 7 4 :=
  finalRootFlatTorusCertificate_of_model finalRootFlatModel

theorem finalLowD7M4RootFlatCertificateFamily :
    FinalLowD7M4RootFlatCertificateFamily :=
  finalLowD7M4RootFlatCertificateFamily_of_certificate
    finalRootFlatTorusCertificate

