@TorusEven.Collar.oneGap : ∀ {α : Type u_1} [inst : Fintype α] [inst_1 : DecidableEq α] {m : ℕ} [inst_2 : NeZero m]
  (S : Equiv.Perm α) (U : Set α) [inst_3 : DecidablePred fun x => x ∈ U] (δ : α → ZMod m) (a : α),
  Shared.IsSingleCycleMap ⇑S →
    a ∈ U →
      (∀ (x : α), δ x ≠ 0 → x ∈ TorusEven.Surgery.openGap S U a) →
        IsUnit (∑ x, δ x) → TorusEven.Collar.OneGapConclusion S U δ a
@TorusEven.Collar.relative_transport : ∀ {α : Type u_1} [inst : Fintype α] [inst_1 : DecidableEq α] {m : ℕ}
  [inst_2 : NeZero m] (S : Equiv.Perm α) (U : Set α) [inst_3 : DecidablePred fun x => x ∈ U] (δ : α → ZMod m),
  TorusEven.Collar.UnitCarry S δ →
    TorusEven.Collar.GapSupport S U δ →
      ∀ (r : Equiv.Perm ↑U),
        TorusEven.Surgery.circuitCount
            (TorusEven.Surgery.patch (TorusEven.Collar.lift S δ) (TorusEven.Collar.zeroSection U)
              (TorusEven.Collar.boundaryLift U r)) =
          TorusEven.Surgery.circuitCount (TorusEven.Surgery.patch S U r)
@TorusEven.Collar.FibreGap.lift_preserves : ∀ {Y : Type u_1} [inst : Fintype Y] [inst_1 : DecidableEq Y] {m : ℕ}
  [inst_2 : NeZero m] (S : Equiv.Perm (Y × ZMod m)) (U : Set (Y × ZMod m)) [inst_3 : DecidablePred fun x => x ∈ U]
  (δ : Y × ZMod m → ZMod m),
  TorusEven.Collar.FibreGap S U →
    (∀ (y : Y), δ (y, 0) = 0) →
      TorusEven.Collar.UnitCarry S δ →
        TorusEven.Collar.FibreGap (TorusEven.Collar.lift S δ) (TorusEven.Collar.zeroSection U)
@TorusEven.Collar.MultitorusFactorization.split : {C : Type u_1} →
  {I : Type u_2} →
    [inst : Fintype C] →
      [DecidableEq C] →
        [inst_2 : DecidableEq I] →
          {m : ℕ} →
            (F : TorusEven.Collar.MultitorusFactorization C I m) →
              (i : I) →
                (J : (I → ZMod m) → Finset C) →
                  (b : ℕ) →
                    0 < b →
                      b < F.width i →
                        (∀ (x : I → ZMod m), J x ⊆ F.users x i) →
                          (∀ (x : I → ZMod m), (J x).card = b) → TorusEven.Collar.MultitorusFactorization C (Option I) m
@TorusEven.Collar.Incidence.evenComponents_of_coherent_odd_columns : ∀ {B : Type u_1} {R : Type u_2} {Ω : Type u_3}
  [inst : Fintype B] [inst_1 : Fintype R] [Nonempty R] [Finite Ω] [inst_4 : DecidableEq Ω] (J : B → R → Finset Ω),
  (∀ (p : B × R), (J p.1 p.2).Nonempty) →
    (∀ (b : B), TorusEven.Collar.Incidence.Coherent (J b)) →
      ∀ (w : B → ℕ),
        (∀ (b : B) (r : R), (J b r).card = w b) →
          Even (Fintype.card R) →
            (∀ (x : Ω), Odd {p | x ∈ J p.1 p.2}.card) → TorusEven.Collar.Incidence.EvenComponents fun p => J p.1 p.2
