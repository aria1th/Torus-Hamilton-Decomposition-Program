@TorusEven.Collar.RelativeCollarState.exists_split : ∀ {C : Type u_1} {I : Type u_2} {Y : Type u_3} [inst : Fintype C]
  [inst_1 : DecidableEq C] [inst_2 : Fintype I] [inst_3 : DecidableEq I] [inst_4 : Fintype Y] {m : ℕ}
  [inst_5 : NeZero m] {F : TorusEven.Collar.MultitorusFactorization C I m} {frame : Y × ZMod m ≃ (I → ZMod m)}
  {active : Finset C} {U : Set (I → ZMod m)} [inst_6 : DecidablePred fun x => x ∈ U]
  (h : TorusEven.Collar.RelativeCollarState F frame active U),
  4 ≤ m →
    Even m →
      ∀ (i : I) (hi : 2 ≤ F.width i),
        ∃ S,
          TorusEven.Collar.RelativeCollarState (S.factorization ⋯ hi) (TorusEven.Collar.splitChart i) active
              (TorusEven.Collar.splitMarks U i) ∧
            ∀ (R : TorusEven.Collar.Recolouring F active U) (c : C),
              TorusEven.Surgery.circuitCount ((R.lift h S hi).factorization.step c) =
                TorusEven.Surgery.circuitCount (R.factorization.step c)
@TorusEven.Collar.RelativeCollarState.resolution : ∀ {d m : ℕ} [inst : NeZero m] {I Y : Type} [inst_1 : Fintype I]
  [inst_2 : DecidableEq I] [Finite Y] {F : TorusEven.Collar.MultitorusFactorization (Fin d) I m}
  {frame : Y × ZMod m ≃ (I → ZMod m)} {active : Finset (Fin d)} {U : Set (I → ZMod m)}
  [inst_4 : DecidablePred fun x => x ∈ U],
  TorusEven.Collar.RelativeCollarState F frame active U → 4 ≤ m → Even m → TorusEven.Collar.SplitResolution F F.excess
@TorusEven.Collar.RelativeCollarState.hamilton_decomposition : ∀ {d m : ℕ} [inst : NeZero m] {I Y : Type}
  [inst_1 : Fintype I] [inst_2 : DecidableEq I] [Finite Y] {F : TorusEven.Collar.MultitorusFactorization (Fin d) I m}
  {frame : Y × ZMod m ≃ (I → ZMod m)} {active : Finset (Fin d)} {U : Set (I → ZMod m)}
  [inst_4 : DecidablePred fun x => x ∈ U],
  TorusEven.Collar.RelativeCollarState F frame active U →
    4 ≤ m →
      Even m →
        ∀ (R : TorusEven.Collar.Recolouring F active U),
          (∀ (c : Fin d), Shared.IsSingleCycleMap ⇑(R.factorization.step c)) → Nonempty (Shared.CayleyDecomposition d m)
