theorem schedule_layerBijective : schedule.layerBijective := by
  intro t c
  generalize hftdef : zmodToFin 4 t = ft
  have hft : ((ft.val : Nat) : ZMod 4) = t := by
    rw [← hftdef]
    exact zmodToFin_val_cast 4 t
  fin_cases ft
  · have ht : t = (0 : ZMod 4) := by
      simpa using hft.symm
    subst t
    fin_cases c
    · change Function.Bijective (schedule.layerMap (0 : ZMod 4) (0 : Color))
      rw [layerMap_eq_map0_0]
      exact FinMapArrayCert.bijective_of_ok layerCert0_0 layerCert0_0_ok
    · change Function.Bijective (schedule.layerMap (0 : ZMod 4) (1 : Color))
      rw [layerMap_eq_map0_1]
      exact FinMapArrayCert.bijective_of_ok layerCert0_1 layerCert0_1_ok
    · change Function.Bijective (schedule.layerMap (0 : ZMod 4) (2 : Color))
      rw [layerMap_eq_map0_2]
      exact FinMapArrayCert.bijective_of_ok layerCert0_2 layerCert0_2_ok
    · change Function.Bijective (schedule.layerMap (0 : ZMod 4) (3 : Color))
      rw [layerMap_eq_map0_3]
      exact FinMapArrayCert.bijective_of_ok layerCert0_3 layerCert0_3_ok
    · change Function.Bijective (schedule.layerMap (0 : ZMod 4) (4 : Color))
      rw [layerMap_eq_map0_4]
      exact FinMapArrayCert.bijective_of_ok layerCert0_4 layerCert0_4_ok
  · have ht : t = (1 : ZMod 4) := by
      simpa using hft.symm
    subst t
    fin_cases c
    · change Function.Bijective (schedule.layerMap (1 : ZMod 4) (0 : Color))
      rw [layerMap_eq_map1_0]
      exact FinMapArrayCert.bijective_of_ok layerCert1_0 layerCert1_0_ok
    · change Function.Bijective (schedule.layerMap (1 : ZMod 4) (1 : Color))
      rw [layerMap_eq_map1_1]
      exact FinMapArrayCert.bijective_of_ok layerCert1_1 layerCert1_1_ok
    · change Function.Bijective (schedule.layerMap (1 : ZMod 4) (2 : Color))
      rw [layerMap_eq_map1_2]
      exact FinMapArrayCert.bijective_of_ok layerCert1_2 layerCert1_2_ok
    · change Function.Bijective (schedule.layerMap (1 : ZMod 4) (3 : Color))
      rw [layerMap_eq_map1_3]
      exact FinMapArrayCert.bijective_of_ok layerCert1_3 layerCert1_3_ok
    · change Function.Bijective (schedule.layerMap (1 : ZMod 4) (4 : Color))
      rw [layerMap_eq_map1_4]
      exact FinMapArrayCert.bijective_of_ok layerCert1_4 layerCert1_4_ok
  · have ht : t = (2 : ZMod 4) := by
      simpa using hft.symm
    subst t
    fin_cases c
    · change Function.Bijective (schedule.layerMap (2 : ZMod 4) (0 : Color))
      rw [layerMap_eq_map2_0]
      exact FinMapArrayCert.bijective_of_ok layerCert2_0 layerCert2_0_ok
    · change Function.Bijective (schedule.layerMap (2 : ZMod 4) (1 : Color))
      rw [layerMap_eq_map2_1]
      exact FinMapArrayCert.bijective_of_ok layerCert2_1 layerCert2_1_ok
    · change Function.Bijective (schedule.layerMap (2 : ZMod 4) (2 : Color))
      rw [layerMap_eq_map2_2]
      exact FinMapArrayCert.bijective_of_ok layerCert2_2 layerCert2_2_ok
    · change Function.Bijective (schedule.layerMap (2 : ZMod 4) (3 : Color))
      rw [layerMap_eq_map2_3]
      exact FinMapArrayCert.bijective_of_ok layerCert2_3 layerCert2_3_ok
    · change Function.Bijective (schedule.layerMap (2 : ZMod 4) (4 : Color))
      rw [layerMap_eq_map2_4]
      exact FinMapArrayCert.bijective_of_ok layerCert2_4 layerCert2_4_ok
  · have ht : t = (3 : ZMod 4) := by
      simpa using hft.symm
    subst t
    fin_cases c
    · change Function.Bijective (schedule.layerMap (3 : ZMod 4) (0 : Color))
      rw [layerMap_eq_map3_0]
      exact FinMapArrayCert.bijective_of_ok layerCert3_0 layerCert3_0_ok
    · change Function.Bijective (schedule.layerMap (3 : ZMod 4) (1 : Color))
      rw [layerMap_eq_map3_1]
      exact FinMapArrayCert.bijective_of_ok layerCert3_1 layerCert3_1_ok
    · change Function.Bijective (schedule.layerMap (3 : ZMod 4) (2 : Color))
      rw [layerMap_eq_map3_2]
      exact FinMapArrayCert.bijective_of_ok layerCert3_2 layerCert3_2_ok
    · change Function.Bijective (schedule.layerMap (3 : ZMod 4) (3 : Color))
      rw [layerMap_eq_map3_3]
      exact FinMapArrayCert.bijective_of_ok layerCert3_3 layerCert3_3_ok
    · change Function.Bijective (schedule.layerMap (3 : ZMod 4) (4 : Color))
      rw [layerMap_eq_map3_4]
      exact FinMapArrayCert.bijective_of_ok layerCert3_4 layerCert3_4_ok

